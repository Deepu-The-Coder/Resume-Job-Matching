# Server Configuration
PORT=3000
HTTP_BODY_LIMIT=1mb
UPLOAD_MAX_BYTES=5242880
DB_MAX_RETRIES=5
DB_INITIAL_RETRY_DELAY_MS=2000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=86400

# Database & Cache
MONGO_URI=mongodb://localhost:27017/resumematcher
REDIS_URL=redis://localhost:6379

# AI & Embeddings
EMBEDDING_API_URL=http://localhost:11434
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_MAX_INPUT_CHARACTERS=16000
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BASE_MS=1000
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_RETRIES=2
LLM_REQUEST_TIMEOUT_MS=15000
LLM_RETRY_BASE_MS=1000

# Cache & Rate Limiting
CACHE_TTL_SECONDS=86400
MATCHING_DEFAULT_K=10
EXPLANATION_DEFAULT_TOP=3
SEMANTIC_CACHE_THRESHOLD=0.95
CHEAP_RATE_LIMIT_CAPACITY=60
CHEAP_RATE_LIMIT_REFILL_PER_SECOND=1
AI_RATE_LIMIT_CAPACITY=10
AI_RATE_LIMIT_REFILL_PER_SECOND=0.1
BULK_EMBED_CONCURRENCY=4
QUEUE_JOB_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000
QUEUE_REMOVE_ON_COMPLETE_AGE_SECONDS=86400
QUEUE_REMOVE_ON_COMPLETE_COUNT=1000
CACHE_MAX_RECENT_ENTRIES=200
LLM_RESUME_EXCERPT_CHARACTERS=1600
LLM_JOB_EXCERPT_CHARACTERS=1600
EMBEDDING_INPUT_PRICE_PER_1K_TOKENS=0
LLM_INPUT_PRICE_PER_1K_TOKENS=0
LLM_OUTPUT_PRICE_PER_1K_TOKENS=0
LLM_AVERAGE_INPUT_TOKENS=1000
LLM_AVERAGE_OUTPUT_TOKENS=200

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000/api
